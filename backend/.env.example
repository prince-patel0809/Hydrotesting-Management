# Application Settings
PROJECT_NAME="FuelFlux Hydrotesting Management System"
ENVIRONMENT="development"
HOST="0.0.0.0"
PORT=8000

# Database Configuration
# Set MONGODB_URI to your MongoDB connection string (e.g., local MongoDB or MongoDB Atlas)
MONGODB_URI="mongodb://localhost:27017"
DATABASE_NAME="fuelflux_hydrotesting"

# Set to true to force in-memory mock MongoDB (useful for standalone demo / CI testing)
# If false, it connects to MONGODB_URI and falls back gracefully to in-memory mock if MongoDB is unreachable
USE_IN_MEMORY_DB=false

# CORS Configuration (comma-separated origins)
CORS_ORIGINS="http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,http://127.0.0.1:3000"
